# Local operating-system, editor and Python files
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
.env
.env.*
!.env.example
# Datasets, weights and pipeline runs are generated (see README); only placeholders are tracked,
# plus the tested ResNet that the demo serves (models/resnet/, about 2.8 MB).
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!**/.gitkeep
models/*
!models/.gitkeep
!models/resnet/
*.pt
*.pth
!models/resnet/best.pt
runs/
reports/environment-*.txt
